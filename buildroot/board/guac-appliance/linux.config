# Kernel config FRAGMENT for the Guac Access Suite appliance — NOT a
# complete, drop-in .config. This lists the options that matter on top of
# whatever base x86_64 kernel config Buildroot's BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG
# starts from; it has never been merged against a real kernel source tree
# or built, since no Buildroot toolchain/kernel source was available in
# the environment this was written in.
#
# To actually produce a working .config from this fragment:
#   1. Build once with a stock/minimal x86_64 config (Buildroot's own
#      board/pc/linux.config is a reasonable starting point) to get a
#      baseline that boots under BIOS/GRUB at all.
#   2. Merge this fragment on top with the kernel's own
#      scripts/kconfig/merge_config.sh, then run `make linux-menuconfig`
#      once to resolve any dependency prompts before building for real.
#   3. Copy the resulting full .config back into
#      board/guac-appliance/linux.config so subsequent builds don't need
#      the merge step again.
#
# What's listed here and why: VMware's paravirtualized guest drivers
# (network, SCSI, balloon, guest info channel) — without these, the VM
# would still boot via generic/emulated devices, just slower and without
# guestinfo/OVF-property access, which the appliance's first-boot
# configuration depends on.

# vmxnet3 — VMware's paravirtualized NIC. Without this the VM falls back
# to an emulated e1000/e1000e, which works but is slower and is not what
# vSphere presents by default on a modern ESXi host.
CONFIG_VMXNET3=y

# PVSCSI — VMware's paravirtualized SCSI controller, the default disk
# controller vSphere presents for Linux guest OS types.
CONFIG_SCSI_VMWARE_PVSCSI=y

# Guest info / backdoor channel — vmtoolsd and vmware-rpctool (used by the
# appliance's first-boot script to read OVF properties) talk to the
# hypervisor primarily via the VMware "backdoor" I/O-port protocol, which
# is largely userspace-only and doesn't strictly require a kernel module.
# VMCI (used for vSockets and some VMware-specific IPC) and the balloon
# driver are included here since open-vm-tools commonly expects them
# available — but this specific claim (that VMCI is required for basic
# guestinfo property reads) hasn't been independently confirmed against
# open-vm-tools' own source, unlike the vmxnet3/pvscsi claims above. Worth
# double-checking against a real build before relying on it.
CONFIG_VMWARE_VMCI=y
CONFIG_VMWARE_BALLOON=y

# Virtio devices — the primary target under QEMU (see
# buildroot/README-qemu.md), which is now a first-class, self-contained
# distribution path alongside the VMware/OVA one, not just a local-testing
# convenience. CONFIG_SCSI_VIRTIO matters beyond just "does the disk show
# up at all": run-qemu.sh deliberately uses virtio-scsi (not the more
# common virtio-blk) so both disks appear as /dev/sda/sdb under QEMU too,
# matching the same device-naming convention guac-appliance-firstboot.sh
# already assumes for the VMware/PVSCSI case — without CONFIG_SCSI_VIRTIO,
# that assumption would silently break under QEMU (virtio-blk disks show
# up as /dev/vda/vdb instead). Verified against Buildroot's own real
# board/qemu/x86_64/linux.config, which enables exactly this symbol.
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_SCSI_VIRTIO=y

# cgroup v2 unified hierarchy + the specific cgroup controllers Docker's
# containerd/runc actually need (cpu, memory, pids, io) — required
# regardless of hypervisor.
CONFIG_CGROUPS=y
CONFIG_CGROUP_PIDS=y
CONFIG_CGROUP_FREEZER=y
CONFIG_MEMCG=y
CONFIG_BLK_CGROUP=y
CONFIG_CPUSETS=y
CONFIG_CGROUP_SCHED=y

# Overlay filesystem — the default (and best-supported) Docker storage
# driver on a Linux guest.
CONFIG_OVERLAY_FS=y

# Namespaces — required for containers regardless of storage driver.
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_IPC_NS=y
CONFIG_USER_NS=y
CONFIG_PID_NS=y
CONFIG_NET_NS=y

# netfilter/iptables — Docker's default networking (bridge + NAT) needs
# these; docker-engine's Config.in already selects the iptables package
# itself, this is the corresponding kernel-side requirement.
CONFIG_NETFILTER=y
CONFIG_NF_NAT=y
CONFIG_IP_NF_NAT=y
CONFIG_IP_NF_FILTER=y
CONFIG_IP_NF_TARGET_MASQUERADE=y
CONFIG_NETFILTER_XT_MATCH_ADDRTYPE=y
CONFIG_NETFILTER_XT_MATCH_CONNTRACK=y
CONFIG_BRIDGE=y
CONFIG_BRIDGE_NETFILTER=y
