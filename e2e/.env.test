# Used only by docker-compose.test.yml — throwaway values, never real secrets.

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=guac_e2e
POSTGRES_USER=guac_e2e
POSTGRES_PASSWORD=e2e-test-password

# Vault runs in `server -dev` mode in the test stack (see
# docker-compose.test.yml), auto-unsealed with a fixed root token. The
# vault-init service (e2e/vault-init.sh) bootstraps the Transit engine and
# an AppRole with this exact role_id/secret_id — role_id via the AppRole
# role name (deterministic), secret_id via Vault's custom-secret-id
# endpoint (fixed on purpose, since ordinary secret-id generation is random
# and wouldn't match a static .env value).
VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID=e2e-fixed-role-id-for-testing-only
VAULT_SECRET_ID=e2e-fixed-secret-id-for-testing-only

SESSION_SECRET=e2e-test-session-secret-not-for-real-use
JWT_SECRET=e2e-test-jwt-secret-not-for-real-use
GUAC_TOKEN_ENCRYPTION_KEY=e2e0123456789e2e0123456789e2e01

GUACD_HOST=guacd
GUACD_PORT=4822

REDIS_HOST=redis
REDIS_PORT=6379

RECORDINGS_PATH=/data/recordings
RDP_DRIVES_PATH=/data/rdp-drives

PUBLIC_URL=http://localhost:5173
