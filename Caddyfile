# Optional TLS-terminating reverse proxy in front of the frontend container.
# Caddy handles Let's Encrypt certificate issuance and renewal automatically —
# no certbot cron jobs, no manual renewal. Requires:
#   1. A real domain pointed at this host (DOMAIN env var below)
#   2. Ports 80 and 443 reachable from the internet (80 is needed for the
#      ACME HTTP-01 challenge, even though everything redirects to 443)
#
# Enable with: docker compose -f docker-compose.prod.yml -f docker-compose.caddy.yml up -d
{$DOMAIN} {
	reverse_proxy frontend:8080 {
		# Guacamole's WebSocket tunnel and the bookmark proxy both need the
		# upgrade headers forwarded, not just plain HTTP.
		header_up Host {host}
		header_up X-Real-IP {remote_host}
	}

	encode gzip

	# HSTS — safe to enable once you're committed to this domain always
	# being served over HTTPS.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
