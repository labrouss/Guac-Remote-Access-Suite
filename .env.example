# ---- Postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=guac_access_suite
POSTGRES_USER=guac_app
POSTGRES_PASSWORD=changeme_generate_a_strong_random_value

# ---- Vault (Transit secrets engine for credential encryption) ----
# http, not https — vault-config.hcl sets tls_disable = 1, since this app's
# backend only ever reaches Vault over the internal Docker network, never
# across anything untrusted. A previous default here was https://, which
# would fail outright (a TLS handshake against a plain-HTTP listener) —
# found via a live deployment, right after fixing the same http/https
# mismatch in vault-config.hcl's own listener config.
VAULT_ADDR=http://vault:8200
VAULT_ROLE_ID=
VAULT_SECRET_ID=
# Used only for initial bootstrap, not stored long-term:
VAULT_BOOTSTRAP_TOKEN=

# ---- Session / auth ----
SESSION_SECRET=changeme_generate_a_strong_random_value
JWT_SECRET=changeme_generate_a_strong_random_value
# A session's own JWT is refreshed (sliding window) on every authenticated
# request, so this is really an IDLE timeout, not a fixed session length —
# stay actively using the app and you're never logged out until the
# absolute cap below. Minutes.
SESSION_IDLE_TIMEOUT_MINUTES=30
# Hard ceiling from the moment of login, regardless of activity — matches
# this app's previous fixed 12h session length, now enforced as a cap
# rather than the only expiry mechanism. Hours.
SESSION_ABSOLUTE_MAX_HOURS=12

# ---- guacd / guacamole-lite ----
GUACD_HOST=guacd
GUACD_PORT=4822
# Any random value works, any length — it's hashed (SHA-256) into a real
# AES-256 key internally, rather than needing to already be exactly 32
# bytes itself. That used to matter and didn't work correctly: a real bug
# found via a live deployment, where a key that wasn't exactly 32 bytes
# (this very placeholder is 36) made guacamole-lite's own token decryption
# fail with "Invalid key length" on every single connection attempt,
# silently — see services/guacTokenKey.ts for the full story. Still worth
# using a genuinely random value rather than leaving this placeholder,
# just no longer for a length reason.
GUAC_TOKEN_ENCRYPTION_KEY=changeme_generate_a_strong_random_value

# ---- Redis (BullMQ job queue for video export) ----
REDIS_HOST=redis
REDIS_PORT=6379

# ---- Recording storage ----
RECORDINGS_PATH=/data/recordings
RECORDING_RETENTION_DAYS=90
# 0 = disabled. Set to a byte count (e.g. 536870912000 for 500GB) to have
# guac-worker log a warning once cumulative recording storage crosses it.
MAX_RECORDINGS_BYTES=0

# ---- RDP drive redirection (shared between backend and guacd, must match) ----
RDP_DRIVES_PATH=/data/rdp-drives

# ---- Instance ----
# Set this to your ACTUAL address, protocol included — two real things
# depend on it matching reality exactly, not just one:
#
# 1. The setup wizard's CSRF-protecting session cookie derives its
#    `secure` flag from whether this genuinely starts with https://,
#    confirmed as necessary by a real deployment (see app.ts's
#    session() config comment): a `secure: true` cookie is never sent
#    by the browser over plain HTTP, which breaks the setup wizard
#    entirely if this is left as a placeholder that doesn't match
#    reality.
# 2. Passkeys (services/webauthn.ts) derive their own RP ID and origin
#    from this exact value — confirmed as necessary by a second real
#    deployment, reported live: enabling HTTPS via one of the Caddy
#    overlays after initial setup, without also updating this to match
#    the new https:// address actually being used, makes every passkey
#    registration and sign-in fail outright ("Could not verify this
#    passkey." / "That passkey could not be used to sign in.") — not a
#    passkey-specific bug, but this same value being stale. If you
#    later add TLS to a deployment that was already set up over plain
#    HTTP, update this to match before trying passkeys, and restart the
#    backend (this is read once at startup, not re-checked per
#    request). With docker-compose.caddy-internal.yml's own on-demand
#    TLS specifically, which can serve valid HTTPS for several
#    different hostnames/IPs to the same instance simultaneously — pick
#    the one you'll consistently use for passkeys and set this to
#    exactly that one; a credential registered under one hostname won't
#    validate under a different one, by design of the WebAuthn standard
#    itself, not a limitation of this app.
#
# This app's own default posture is plain HTTP (see README.md's TLS
# section) — deliberately defaulting to http:// here rather than
# https://, so a fresh install that hasn't set up TLS yet doesn't
# silently fall into either trap above.
PUBLIC_URL=http://your-hostname.example.com

# ---- Syslog forwarding (optional) ----
# When enabled, every audit_log entry (logins, credential changes, admin
# actions, file transfers, session connects/recordings, etc.) is also
# forwarded as an RFC 5424 message to the syslog server below, in addition
# to being written to Postgres (Postgres remains the durable record —
# syslog forwarding is fire-and-forget over UDP by default and never
# blocks or fails a request if the syslog server is unreachable).
SYSLOG_ENABLED=false
SYSLOG_HOST=localhost
SYSLOG_PORT=514
# udp (default, fire-and-forget) | tcp (reliable) | tls (encrypted, use this
# over any untrusted network)
SYSLOG_PROTOCOL=udp
# RFC 5424 facility code: 4 = auth, 16-23 = local0-7. Defaults to 16 (local0).
SYSLOG_FACILITY=16
SYSLOG_APP_NAME=guac-access-suite

# ---- Optional: Caddy public-domain TLS overlay ----
# Your real public hostname, e.g. guac.example.com — used for automatic
# Let's Encrypt issuance (docker-compose.caddy.yml). Needs a public DNS
# record actually pointing at this host and ports 80/443 reachable from
# the internet, or issuance will fail outright.
#
# Not used by docker-compose.caddy-internal.yml at all — that overlay's
# on-demand TLS mints a certificate automatically for whichever hostname
# or IP a request actually arrives on, so there's nothing to set here for
# it. See README.md "TLS" for the full story on why (a real, reported
# failure — a fixed DOMAIN there once meant only that one exact value
# worked, and any other valid way of reaching the same host failed
# outright).
DOMAIN=

# ---- Optional: Active Directory login ----
# Unset (any of AD_URL/AD_BASE_DN/AD_BIND_DN/AD_BIND_PASSWORD/
# AD_REQUIRED_GROUP_DN missing) means AD is off entirely — every login
# goes through the local username/password path exactly as before,
# nothing else in this section matters. Setting all five turns it on:
# any AD account that's a member of AD_REQUIRED_GROUP_DN can then sign
# in, auto-created here (the same personal "My Connections" list any
# new account gets) on first successful login — not a full sync of AD's
# own group structure into this app's own groups, deliberately scoped
# narrower than that: this only gates who's allowed to log in at all,
# nothing about what they can see or do once they have, which is still
# assigned locally, by hand, the same way as for everyone else.
#
# ldaps://, not ldap:// — this app's own security posture throughout
# (Vault-encrypted stored credentials, HTTPS-required passkeys) applies
# here too: a plaintext LDAP bind would mean this service account's own
# password, and every user's AD password on every login attempt, going
# out unencrypted. Confirm your AD environment actually has LDAPS
# enabled (most do, by default) before turning this on.
AD_URL=ldaps://dc.example.com

# The search base for finding a user by username, e.g. the whole
# domain (dc=example,dc=com) or a specific OU
# (ou=Employees,dc=example,dc=com) to search a narrower part of the
# directory.
AD_BASE_DN=

# A service account's own DN and password — used only to search for a
# user's own DN by username; the actual password check that follows is
# always a real bind as that user's own DN with the password they
# submitted, never this account's own credential standing in for it.
# This account needs read access to search AD_BASE_DN and read the
# memberOf attribute on user entries; nothing more.
AD_BIND_DN=cn=svc-guac-access,ou=Service Accounts,dc=example,dc=com
AD_BIND_PASSWORD=

# {{username}} is replaced with whatever was typed into the login
# form's own username field, escaped against LDAP filter injection
# first. sAMAccountName is the ordinary Windows logon name
# (DOMAIN\username's own second half) — change this only if your own
# AD schema needs a different attribute to look users up by (e.g.
# userPrincipalName for a UPN-style login instead).
AD_USER_FILTER=(sAMAccountName={{username}})

# The one AD group whose members are allowed to sign in at all — its
# own full DN, not just a name, e.g.
# cn=GuacUsers,ou=Groups,dc=example,dc=com. Everyone else's AD login
# attempt is rejected the same generic way a wrong local password is,
# not distinguished from it.
AD_REQUIRED_GROUP_DN=

# Optional, and a separate concern from AD_REQUIRED_GROUP_DN above —
# that one only gates whether someone can sign in at all; this one
# decides which of this app's own groups they land in once they have,
# genuinely re-checked on every login (not just the first) against
# their AD group membership at that moment. A JSON array of
# {"dn": "<AD group DN>", "localGroup": "<this app's own group name>"}
# pairs — JSON specifically because an LDAP DN always contains its own
# commas, which would make any simpler comma/semicolon-delimited format
# for multiple mappings genuinely ambiguous to parse correctly. A
# mapped local group is created automatically (with a note in its own
# description of which AD group it came from) the first time it's
# actually needed — no need to create it by hand first.
#
# Left unset (or an empty array) entirely: an AD account still signs
# in fine, but is never placed into any of this app's own groups
# automatically — matching this app's own original AD scope before this
# was added, and still a completely reasonable choice if you'd rather
# assign every AD account's access by hand, the same way as any locally
# created account.
#
# Since this is a genuine, ongoing sync, not a one-time grant: losing
# access to a mapped AD group removes the corresponding local group
# membership on that person's very next login too, not just adding one
# when they newly qualify — but only ever a membership this sync itself
# granted. A group membership an admin grants by hand, through the
# ordinary admin panel, is never touched by this, even for an AD
# account, even if the group name happens to match one of these
# mappings — the reverse is also worth knowing: manually *removing*
# someone from a group this sync currently considers them a member of
# doesn't stick, since their own AD membership is what actually decides
# that on their next login, not the local row on its own.
#
# Example:
# AD_GROUP_MAPPINGS=[{"dn":"CN=GuacAdmins,OU=Groups,DC=example,DC=com","localGroup":"Administrators"},{"dn":"CN=GuacUsers,OU=Groups,DC=example,DC=com","localGroup":"AD Users"}]
AD_GROUP_MAPPINGS=

# If AD login fails with an error containing UNABLE_TO_VERIFY_LEAF_SIGNATURE
# (docker compose logs backend will show it — see the "empty catch block"
# fix noted in TODO.md), this is almost certainly why: a real AD
# environment's domain controller normally presents a certificate issued
# by that organization's own internal/enterprise CA, not a public one,
# which Node.js doesn't trust by default. Drop that CA's own certificate
# (PEM format) into ./ca-certs/ (see that directory's own README.md for
# exactly how to get it from a domain-joined Windows machine) and point
# this at it, using the file's path *inside the container* — always
# /app/ca-certs/<filename>, matching that bind mount, regardless of where
# ./ca-certs/ actually lives on the host:
NODE_EXTRA_CA_CERTS=

